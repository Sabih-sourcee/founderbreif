{
  "expo": {
    "name": "FounderBrief",
    "slug": "founderbrief",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#DAF7F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.founderbrief.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DAF7F3"
      },
      "package": "com.founderbreif.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "FounderBrief needs microphone access so you can dictate your startup idea."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://founderbreif.vercel.app",
      "eas": {
        "projectId": "53e234a3-5c39-4a3f-9191-f0e6bdd480e6"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
